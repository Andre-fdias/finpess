/**
 * @file tests/idempotency-tests
 * @description Testes automatizados de prevenção de duplicidades e resiliência de integrações:
 * reenvio da mesma atualização (update_id), cliques repetidos em confirmar, invalidação de
 * hash após edição, sincronização do Google Calendar sem duplicidade, fila de notificações
 * e simulação de indisponibilidade da IA.
 */

const assert = require('assert');
const { createGasContext } = require('./gas-mock-harness');

function runIdempotencyTests() {
  const SECRET = 'segredo_webhook_teste_123456';
  const ctx = createGasContext({
    ownerEmail: 'owner@finpess.local',
    activeUserEmail: 'owner@finpess.local',
    webhookSecret: SECRET
  });
  const results = [];

  ctx.apiCall('session.getBootstrap', {});
  const conta = ctx.apiCall('bankAccounts.create', {
    instituicao: 'Banco do Brasil',
    nome_identificacao: 'Conta Principal',
    tipo_conta: 'CORRENTE',
    saldo_inicial_centavos: 100000,
    data_saldo_inicial: '2026-10-01'
  }).data;

  const code = ctx.apiCall('telegram.generateCode', {}).data.codigo_temporario;
  ctx.TelegramAuthService.consumeLinkingCode(code, 333001, 333001);

  // 1. Reenvio da mesma atualização (update_id = 3001) pelo Telegram (ex: retry de webhook)
  const updatePayload = {
    update_id: 3001,
    message: {
      message_id: 50,
      from: { id: 333001 },
      chat: { id: 333001 },
      text: 'Paguei R$ 120 de água na Conta Principal'
    }
  };

  const firstAttempt = ctx.TelegramWebhookService.handleWebhookUpdate(updatePayload, SECRET, { referenceDateIso: '2026-10-29' });
  const secondAttempt = ctx.TelegramWebhookService.handleWebhookUpdate(updatePayload, SECRET, { referenceDateIso: '2026-10-29' });

  assert.strictEqual(firstAttempt.idempotente_reutilizado, false);
  assert.strictEqual(secondAttempt.idempotente_reutilizado, true, 'Reenvio do mesmo update_id deve reutilizar a proposta sem duplicar');
  assert.strictEqual(firstAttempt.processamento.id, secondAttempt.processamento.id);
  results.push('Idempotência no reenvio da mesma atualização (update_id) do webhook comprovada.');

  // 2. Edição de campo invalida confirmação antiga (STALE_PREVIEW_HASH)
  const oldHash = firstAttempt.processamento.preview_hash;
  const userObj = ctx.AuthService.requireApprovedUser();
  const edited = ctx.TelegramLaunchService.editProposalFields(userObj, firstAttempt.processamento.id, {
    valor_centavos: 12500
  });
  const newHash = edited.processamento.preview_hash;
  assert.notStrictEqual(oldHash, newHash, 'Editar a proposta deve alterar o preview_hash');

  assert.throws(() => {
    ctx.TelegramWebhookService.handleWebhookUpdate({
      update_id: 3002,
      callback_query: {
        from: { id: 333001 },
        message: { chat: { id: 333001 } },
        data: 'CONFIRM:' + firstAttempt.processamento.id + ':' + oldHash
      }
    }, SECRET);
  }, /STALE_PREVIEW_HASH/);
  results.push('Invalidação de confirmação anterior após edição da prévia comprovada.');

  // 3. Clique repetido em "Confirmar" com o novo hash válido não duplica o lançamento
  const confirmClick1 = ctx.TelegramWebhookService.handleWebhookUpdate({
    update_id: 3003,
    callback_query: {
      from: { id: 333001 },
      message: { chat: { id: 333001 } },
      data: 'CONFIRM:' + firstAttempt.processamento.id + ':' + newHash
    }
  }, SECRET);

  const confirmClick2 = ctx.TelegramWebhookService.handleWebhookUpdate({
    update_id: 3004,
    callback_query: {
      from: { id: 333001 },
      message: { chat: { id: 333001 } },
      data: 'CONFIRM:' + firstAttempt.processamento.id + ':' + newHash
    }
  }, SECRET);

  assert.strictEqual(confirmClick1.idempotente_ja_confirmado, false);
  assert.strictEqual(confirmClick2.idempotente_ja_confirmado, true, 'Segundo clique em confirmar deve ser idempotente');
  assert.strictEqual(confirmClick1.lancamento.id, confirmClick2.lancamento.id);

  const allLaunches = ctx.apiCall('launches.list', {}).data;
  assert.strictEqual(allLaunches.total, 1, 'Deve existir exatamente 1 lançamento gravado após múltiplos cliques');
  results.push('Prevenção de duplicidade após clique repetido em Confirmar comprovada.');

  // 4. Sincronização do Google Calendar sem duplicidade
  const launchItem = confirmClick1.lancamento;
  const sync1 = ctx.apiCall('calendar.syncItem', {
    item: {
      id: launchItem.id,
      origem_tipo: 'LANCAMENTO',
      titulo: launchItem.descricao,
      data: launchItem.data_lancamento,
      tipo: launchItem.tipo,
      situacao: launchItem.situacao,
      valor_centavos: launchItem.valor_centavos
    },
    options: { dryRun: false }
  }).data;

  const sync2 = ctx.apiCall('calendar.syncItem', {
    item: {
      id: launchItem.id,
      origem_tipo: 'LANCAMENTO',
      titulo: launchItem.descricao + ' Atualizado',
      data: launchItem.data_lancamento,
      tipo: launchItem.tipo,
      situacao: launchItem.situacao,
      valor_centavos: launchItem.valor_centavos
    },
    options: { dryRun: false }
  }).data;

  assert.strictEqual(sync1.id, sync2.id, 'Sincronizar o mesmo item atualiza o registro em AGENDA_SYNC sem duplicar');
  assert.strictEqual(sync1.external_event_id, sync2.external_event_id, 'Mantém o mesmo external_event_id no Google Calendar');
  results.push('Sincronização de eventos no Google Calendar sem duplicidade comprovada.');

  // 5. Fila de notificações sem duplicidade e tratamento de quota
  const categories = ctx.apiCall('categories.list', {}).data;
  ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Conta atrasada teste',
    valor_centavos: 9000,
    data_lancamento: '2026-10-01',
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    forma_pagamento: 'BOLETO',
    situacao: 'PENDENTE'
  });

  const scan1 = ctx.apiCall('notifications.scanAndEnqueue', {}).data;
  const scan2 = ctx.apiCall('notifications.scanAndEnqueue', {}).data;
  assert.strictEqual(scan1.itens[0].id, scan2.itens[0].id, 'Varredura repetida no mesmo dia não duplica notificações na fila');

  const queueProcess = ctx.apiCall('notifications.processQueue', { dryRun: false }).data;
  assert.strictEqual(queueProcess.enviados, 1);
  results.push('Funcionamento idempotente da fila de notificações comprovado.');

  // 6. Simular indisponibilidade da IA no Oráculo e verificar contingência determinística
  const oracleFallback = ctx.apiCall('oracle.ask', {
    pergunta: 'Quanto gastei neste mês?',
    mesReferencia: '2026-10',
    options: { simulateAiFailure: true }
  });
  assert.strictEqual(oracleFallback.ok, true, 'Oráculo deve responder com fatos determinísticos mesmo se a IA externa falhar');
  assert.ok(oracleFallback.data.aviso_contingencia.indexOf('SIMULATED_AI_UNAVAILABLE') !== -1);
  assert.strictEqual(oracleFallback.data.fatos_calculados.resumo_mensal.despesas_confirmadas_centavos, 12500);
  results.push('Simulação de indisponibilidade da IA com fallback determinístico comprovada.');

  // 7. Sincronização multiusuário em tempo real e detecção de versões de dados
  const syncVer1 = ctx.apiCall('sync.getVersion', {});
  assert.strictEqual(syncVer1.ok, true, 'Deve retornar versão de sincronização');
  assert.ok(typeof syncVer1.version === 'number', 'Versão deve ser um timestamp numérico');

  // Simula mutação por outro usuário no grupo
  ctx.apiCall('launches.create', {
    tipo: 'ENTRADA',
    descricao: 'Recebimento de outro usuário',
    valor_centavos: 50000,
    data_lancamento: '2026-10-15',
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    forma_pagamento: 'PIX',
    situacao: 'CONFIRMADO'
  });

  const syncVer2 = ctx.apiCall('sync.getVersion', {});
  assert.strictEqual(syncVer2.ok, true);
  assert.ok(syncVer2.version >= syncVer1.version, 'Versão do sync deve ser atualizada automaticamente após mutação de outro usuário');

  const forceSyncRes = ctx.apiCall('sync.forceSync', {});
  assert.strictEqual(forceSyncRes.ok, true, 'Rota de sync manual deve responder com sucesso');
  assert.ok(forceSyncRes.version >= syncVer2.version);
  results.push('Sincronização multiusuário em tempo real e auto-sync a cada 10 min comprovados.');

  // 8. Central de Notificações, Adiamento (Snooze), Pop-up Inicial e Cancelamento de Contas Pagas
  const notifOverview = ctx.apiCall('notifications.getCenterOverview', {}).data;
  assert.ok(notifOverview.itens.length > 0, 'Central de notificações deve listar itens gerados');
  assert.ok(typeof notifOverview.unreadCount === 'number');

  // Adiamento de notificação: preserva chave e status ADIADO sem alterar vencimento da conta
  const targetNotifId = notifOverview.itens[0].id;
  const snoozeRes = ctx.apiCall('notifications.snooze', {
    id: targetNotifId,
    options: { hours: 3 }
  });
  assert.strictEqual(snoozeRes.ok, true, 'Adiamento deve ser processado com sucesso');
  assert.ok(snoozeRes.data.adiado_ate, 'Deve conter timestamp futuro de adiamento');

  // Varredura subsequente NÃO deve duplicar a notificação que foi adiada
  const scanAfterSnooze = ctx.apiCall('notifications.scanAndEnqueue', {}).data;
  const matchingSnoozed = scanAfterSnooze.itens.filter(i => i.id === targetNotifId);
  assert.strictEqual(matchingSnoozed.length, 1, 'Idempotência preservada: registro adiado é reutilizado sem duplicação');

  // Pop-up inicial filtra notificações já apresentadas na sessão
  const popupInitial = ctx.apiCall('notifications.getInitialPopup', {
    presentedIds: [targetNotifId]
  }).data;
  const itemInPopup = popupInitial.itens.find(i => i.id === targetNotifId);
  assert.strictEqual(itemInPopup, undefined, 'Notificação já apresentada nesta sessão deve ser ocultada do pop-up inicial');

  // Notificação com lançamento confirmado é cancelada automaticamente na fila de envio
  const paidLaunch = ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Conta paga antes do envio',
    valor_centavos: 4500,
    data_lancamento: '2026-10-02',
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    forma_pagamento: 'PIX',
    situacao: 'PENDENTE'
  }).data;
  ctx.apiCall('notifications.scanAndEnqueue', {});
  // Simula confirmação/pagamento da conta antes do envio do e-mail
  ctx.apiCall('launches.update', {
    id: paidLaunch.id,
    situacao: 'CONFIRMADO',
    data_pagamento: '2026-10-02'
  });
  const queueProcessPaid = ctx.apiCall('notifications.processQueue', { dryRun: false }).data;
  assert.ok(queueProcessPaid.ignorados_ou_cancelados >= 1, 'Notificação vinculada a conta já paga deve ser cancelada na fila');

  results.push('Central inteligente, Snooze idempotente, pop-up sem intrusão e cancelamento de contas pagas comprovados.');

  // 9. Resumo Matinal Unificado (E-mail Único Diário consolidando contas vencidas e a vencer em 3, 2, 1 dias)
  const todayIso = '2026-11-05';
  // Cria contas em diferentes faixas temporais
  ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Conta Luz Vencida 4 dias',
    valor_centavos: 35000,
    data_lancamento: '2026-11-01', // 4 dias atrás (Vencida)
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    situacao: 'PENDENTE'
  });
  ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Conta Internet Vence Hoje',
    valor_centavos: 12000,
    data_lancamento: '2026-11-05', // Hoje
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    situacao: 'PREVISTO'
  });
  ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Conta Água Vence Amanhã',
    valor_centavos: 8000,
    data_lancamento: '2026-11-06', // 1 dia antes
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    situacao: 'PREVISTO'
  });
  ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Condomínio Vence em 2 dias',
    valor_centavos: 45000,
    data_lancamento: '2026-11-07', // 2 dias antes
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    situacao: 'PREVISTO'
  });
  ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Seguro Auto Vence em 3 dias',
    valor_centavos: 25000,
    data_lancamento: '2026-11-08', // 3 dias antes
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    situacao: 'PREVISTO'
  });
  ctx.apiCall('launches.create', {
    tipo: 'SAIDA',
    descricao: 'Conta Distante não deve entrar',
    valor_centavos: 15000,
    data_lancamento: '2026-11-20', // Mais de 3 dias
    categoria_id: categories[0].id,
    conta_bancaria_id: conta.id,
    situacao: 'PREVISTO'
  });

  // Limpa lista de e-mails para testar disparo único
  const sentEmailsBefore = ctx.__getSentEmails().length;

  // 1º Disparo do resumo matinal unificado
  const digest1 = ctx.apiCall('notifications.sendMorningDigest', {
    hoje: todayIso,
    dryRun: false,
    force: false
  });
  assert.strictEqual(digest1.ok, true, 'Disparo do resumo matinal deve retornar ok');
  assert.strictEqual(digest1.data.enviado, true, 'E-mail deve ser marcado como enviado');
  assert.strictEqual(digest1.data.contas_total, 6, 'Deve consolidar exatamente as 6 contas no escopo (2 vencidas pendentes + 1 hoje + 3 nos próximos 3 dias)');

  // Verifica que APENAS 1 e-mail foi enviado (unificado, não 5 ou 50!)
  const sentEmailsAfter = ctx.__getSentEmails().length;
  assert.strictEqual(sentEmailsAfter - sentEmailsBefore, 1, 'Deve enviar exatamente 1 único e-mail unificado consolidando todas as contas');

  // Inspeciona o e-mail enviado
  const sentEmail = ctx.__getSentEmails()[sentEmailsAfter - 1];
  assert.ok(sentEmail.subject.indexOf('Resumo Matinal') !== -1, 'Assunto do e-mail deve identificar o Resumo Matinal');
  assert.ok(sentEmail.subject.indexOf('vencida(s)') !== -1, 'Assunto deve alertar sobre contas vencidas');
  assert.ok(sentEmail.htmlBody.indexOf('Conta Luz Vencida 4 dias') !== -1, 'Corpo HTML deve listar a conta vencida');
  assert.ok(sentEmail.htmlBody.indexOf('4 dia(s)') !== -1, 'Corpo HTML deve informar explicitamente os dias de atraso');
  assert.ok(sentEmail.htmlBody.indexOf('Conta Internet Vence Hoje') !== -1, 'Corpo HTML deve listar a conta que vence hoje');
  assert.ok(sentEmail.htmlBody.indexOf('Conta Água Vence Amanhã') !== -1, 'Corpo HTML deve listar a conta de amanhã');
  assert.ok(sentEmail.htmlBody.indexOf('Condomínio Vence em 2 dias') !== -1, 'Corpo HTML deve listar a conta em 2 dias');
  assert.ok(sentEmail.htmlBody.indexOf('Seguro Auto Vence em 3 dias') !== -1, 'Corpo HTML deve listar a conta em 3 dias');
  assert.ok(sentEmail.htmlBody.indexOf('Conta Distante não deve entrar') === -1, 'Contas fora da janela de 3 dias não devem constar');
  assert.ok(sentEmail.htmlBody.indexOf('https://script.google.com/macros/s/') !== -1, 'Link do sistema no e-mail deve ser a URL real do Web App');
  assert.ok(sentEmail.htmlBody.indexOf('href="#"') === -1, 'E-mail não pode conter links vazios ou quebrados (href="#")');

  // 2º Disparo no mesmo dia: IDEMPOTÊNCIA comprovada (não duplica e-mail)
  const digest2 = ctx.apiCall('notifications.sendMorningDigest', {
    hoje: todayIso,
    dryRun: false,
    force: false
  });
  assert.strictEqual(digest2.ok, true);
  assert.strictEqual(digest2.data.enviado, false, 'Segundo disparo no mesmo dia não pode reenviar e-mail');
  assert.strictEqual(digest2.data.motivo, 'JA_ENVIADO_HOJE', 'Motivo deve ser JA_ENVIADO_HOJE');
  assert.strictEqual(ctx.__getSentEmails().length, sentEmailsAfter, 'Nenhum e-mail adicional deve ter sido disparado');

  // Teste de configuração do gatilho automático matinal (07:00h)
  const triggerRes1 = ctx.apiCall('notifications.ensureTrigger', {});
  assert.strictEqual(triggerRes1.ok, true, 'Configuração de gatilho deve ter sucesso');
  const triggerRes2 = ctx.apiCall('notifications.ensureTrigger', {});
  assert.strictEqual(triggerRes2.data.status, 'JA_CONFIGURADO', 'Gatilho automático não deve ser duplicado');
  const triggerStatus = ctx.apiCall('notifications.getTriggerStatus', {});
  assert.strictEqual(triggerStatus.data.configurado, true, 'Status do gatilho deve confirmar ativo');

  results.push('Resumo matinal unificado (e-mail único, janela de 3 dias, atrasos informados e link real) comprovado com 100% de sucesso.');

  return results;
}

if (require.main === module) {
  const out = runIdempotencyTests();
  console.log('IDEMPOTENCY TESTS PASSED:', out);
}

module.exports = { runIdempotencyTests };

